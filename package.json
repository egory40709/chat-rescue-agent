{
  "name": "chat-rescue-agent",
  "version": "1.2.0",
  "private": true,
  "description": "Local chat export controlled by an AI agent through CLI or MCP stdio",
  "type": "module",
  "engines": { "node": ">=22" },
  "bin": { "chat-rescue-agent": "agent.mjs" },
  "scripts": {
    "mcp": "node mcp.mjs",
    "doctor": "node agent.mjs doctor",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "playwright": "1.64.0",
    "zod": "4.6.7"
  }
}
